# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube a git (ya está en .gitignore).

# 1. Crea una cuenta gratis en https://resend.com
# 2. Genera una API key en el dashboard (Settings > API Keys)
RESEND_API_KEY=

# Correo donde quieres recibir los mensajes del formulario de contacto.
# DEBE ser el mismo correo con el que te registraste en Resend (ver nota abajo).
CONTACT_EMAIL_TO=tu-correo@ejemplo.com

# Nota: mientras no haya dominio propio verificado en Resend, los correos
# se envían desde "onboarding@resend.dev" (el remitente de pruebas de Resend)
# y el plan gratis solo permite enviarlos a CONTACT_EMAIL_TO si es el mismo
# correo con el que te registraste en Resend (en este caso, Gmail, aunque el
# correo público de contacto del sitio sea el de Outlook). Cuando exista un
# dominio propio, se puede verificar en Resend y quitar esta limitación.
